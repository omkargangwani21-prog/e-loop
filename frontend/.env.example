# Leave unset in development (Vite proxies /api to the local server).
# In production set this to the ApiUrl output of the SAM stack, without a trailing slash.
VITE_API_BASE_URL=

# Collector sign-in with Amazon Cognito. Set both from the SAM stack outputs (UserPoolClientId).
# Leave VITE_COGNITO_CLIENT_ID empty in local development to use the shared-key sign-in.
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=ap-south-1
